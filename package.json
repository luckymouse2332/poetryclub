{
  "name": "poetryclub",
  "version": "1.7.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm format:check",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:conventions": "node scripts/check-repository-conventions.mjs current",
    "test:conventions": "node scripts/check-repository-conventions.mjs self-test",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "node scripts/migrate-test-database.mjs",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "account:reset-password": "node scripts/reset-user-password.mjs",
    "lint:js": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "node scripts/format-styles.mjs --write",
    "format:check": "node scripts/format-styles.mjs"
  },
  "dependencies": {
    "@next/env": "^16.4.4",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "38.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
