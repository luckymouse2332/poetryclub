POSTGRES_DB=poetryclub
POSTGRES_USER=poetryclub
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://poetryclub:replace-with-url-encoded-password@db:5432/poetryclub
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
BETTER_AUTH_URL=https://poetry.example.edu
# One-time input for the documented bootstrap command; remove after use.
INITIAL_ADMIN_EMAIL=admin@example.edu
INITIAL_ADMIN_NAME=初始管理员
INITIAL_ADMIN_PASSWORD=replace-with-a-separate-long-random-password
