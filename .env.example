# Local development defaults only. Copy to .env.local and replace the secret.
DATABASE_URL=postgresql://poetryclub:poetryclub_dev@localhost:5432/poetryclub
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
REDIS_URL=redis://127.0.0.1:6379
# Development mode writes password reset messages to the server console with a
# clear development-only marker. Never use this transport in production.
EMAIL_TRANSPORT=development
# Only used by `pnpm admin:bootstrap`. Password/name are required only when
# the target email does not exist yet. Never expose these as NEXT_PUBLIC_*.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=初始管理员
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
# One-time server terminal recovery inputs for `pnpm account:reset-password`.
# Set them only for the command invocation and remove them immediately after.
RESET_USER_EMAIL=
RESET_USER_PASSWORD=
